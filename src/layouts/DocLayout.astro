---
/**
 * DocLayout — Markdown 文档页面布局
 * 继承 FrameworkLayout（含工具栏 + 页脚），用于渲染 Markdown 内容
 *
 * 与站点样式保持一致：正文放入 .content 内容槽，prose 样式见
 * public/assets/app/page/doc.css（标题、段落、列表、引用、代码、表格等）。
 *
 * 增强渲染由构建期完成（src/plugins/rehype-doc.mjs）：
 *   标题锚点、链接语法糖、代码块复制按钮、引用块提示框、任务列表 s-checkbox、图片懒加载；
 * 本布局额外负责：服务端渲染目录（TOC，折叠交给 Sober 的 <s-fold> 组件）、
 * 把 frontmatter 的 nav 桥接到工具栏导航插槽、引入 doc.js 交互。
 *
 * Props:
 *   title       - 页面标题
 *   description - meta description
 *   keywords    - meta keywords
 *   theme       - s-page 主题（默认 light）
 *   heading     - 可选，正文顶部的页头标题（由路由按需传入）
 *   headings    - 可选，Astro render() 返回的标题列表，用于生成目录
 *   toc         - 是否渲染页首目录（默认 true；由 frontmatter `toc: false` 关闭）
 *   nav         - 可选，工具栏导航项 [{ label, href? , cmd?, id? }]，渲染为“标题栏智能插槽”；
 *                 id 与预设按钮同 id 时覆写（保持预设位置），否则与预设按钮合并追加
 *   navPreset   - 可选，toolbar 预设（frontmatter `nav-preset`）：
 *                 字符串 = 预设名；或对象 { set?, loc?, loc-index?, replaceset? }
 *                 · set        引用 assets/app/config/toolbar-presets.js 里的预设，继承其 loc / loc-index 与 nav
 *                 · loc        品牌后缀（渲染为「栈流Streack·<loc>」）
 *                 · loc-index  点击 loc 文字的跳转地址（取代点击品牌默认跳首页）
 *                 · replaceset 占位符替换表 { 名: 值 }，供预设值里的 %xxx% 使用
 *
 * Slots:
 *   default     - Markdown 渲染结果（<Content />）
 *   toolbar-nav / notes / dialogs / scripts — 透传给 FrameworkLayout
 */
import FrameworkLayout from './FrameworkLayout.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface NavItem {
  label: string;
  href?: string;
  cmd?: string;
  id?: string;
}

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  theme?: string;
  heading?: string;
  headings?: Heading[];
  toc?: boolean;
  nav?: NavItem[];
  navPreset?: string | { set?: string; loc?: string; locIndex?: string; replaceset?: Record<string, string | number> };
}

const {
  title,
  description,
  keywords,
  theme = 'light',
  heading,
  headings = [],
  toc = true,
  nav = [],
  navPreset,
} = Astro.props;

const navItems = Array.isArray(nav) ? nav.filter((n) => n && n.label) : [];

/* === toolbar 预设（frontmatter.nav-preset）→ <template> 上的属性 ===
   简写（字符串）= 只引用预设名；完整写法可覆盖 loc / loc-index 并给出 replaceset 占位符替换表 */
const np = typeof navPreset === 'string' ? { set: navPreset } : (navPreset || {});
const presetSet = np.set || undefined;
const presetLoc = np.loc || undefined;
const presetLocIndex = np.locIndex || undefined;
const presetReplaceset =
  np.replaceset && Object.keys(np.replaceset).length > 0
    ? JSON.stringify(np.replaceset)
    : undefined;
const hasToolbarPreset = Boolean(presetSet || presetLoc || presetLocIndex || navItems.length > 0);

/* === 目录（TOC）：由 Astro 的 headings 在服务端生成嵌套列表 === */
const TOC_MAX_DEPTH = 3; // 目录收录的标题层级上限（h2 ~ h3）
const esc = (s: string) =>
  String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

function buildToc(items: Heading[]): string {
  const list = items.filter((h) => h.depth >= 2 && h.depth <= TOC_MAX_DEPTH);
  if (list.length < 2) return '';
  let html = '<ul class="doc-toc-list">';
  let prev = list[0].depth;
  list.forEach((h, i) => {
    const d = h.depth;
    const link = `<a class="doc-toc-link" href="#${esc(h.slug)}">${esc(h.text)}</a>`;
    if (i === 0) {
      html += `<li class="doc-toc-item">${link}`;
    } else if (d > prev) {
      html += `<ul class="doc-toc-list"><li class="doc-toc-item">${link}`;
    } else if (d === prev) {
      html += `</li><li class="doc-toc-item">${link}`;
    } else {
      html += `</li></ul></li>`.repeat(prev - d);
      html += `<li class="doc-toc-item">${link}`;
    }
    prev = d;
  });
  html += `</li></ul>`.repeat(1 + (prev - list[0].depth));
  return html;
}

const tocHtml = buildToc(headings);
---

<FrameworkLayout
  title={title}
  description={description}
  keywords={keywords}
  theme={theme}
>
  <!-- 文档样式 -->
  <link slot="head" rel="stylesheet" href="/assets/app/page/doc.css" />

  <!-- 正文内容（display:contents 包裹防止 Astro 解释 slot 属性） -->
  <div style="display: contents">
    <div class="content doc-content" slot="0">
      <article class="doc-article">
        <div class="doc-body">
          {heading && <h1 class="doc-heading">{heading}</h1>}
          {toc && tocHtml && (
            <s-fold class="doc-toc" data-doc-toc folded="true" role="navigation" aria-label="目录">
              <div slot="trigger" class="doc-toc-head">
                <span class="doc-toc-title">本文内容</span>
                <svg class="doc-toc-chevron" viewBox="0 -960 960 960" aria-hidden="true">
                  <path d="M480-344 240-584l56-56 184 184 184-184 56 56-240 240Z" />
                </svg>
              </div>
              <div class="doc-toc-body" data-doc-toc-body>
                <Fragment set:html={tocHtml} />
              </div>
            </s-fold>
          )}
          <slot />
        </div>
      </article>
    </div>
  </div>

  <!-- frontmatter.nav / nav-preset → 工具栏导航插槽（标题栏智能插槽）
       toolbar-set 引用预设（继承其 loc / loc-index 与 nav）；loc 为品牌后缀；
       loc-index 为点击 loc 文字的跳转地址；replaceset 为占位符替换表（JSON）
       nav 项与预设按钮在 component/toolbar/toolbar-nav.js 里**合并**（带 id 且同 id → 覆写，否则追加） -->
  {hasToolbarPreset && (
    <template
      slot="toolbar-nav"
      data-toolbar-nav
      toolbar-set={presetSet}
      loc={presetLoc}
      loc-index={presetLocIndex}
      replaceset={presetReplaceset}
    >
      {navItems.map((item) =>
        item.cmd ? (
          <div id={item.id} data-cmd={item.cmd} clickable>{item.label}</div>
        ) : item.href ? (
          <div id={item.id} data-cmd={`url:${item.href}|`} clickable>{item.label}</div>
        ) : (
          <div id={item.id}>{item.label}</div>
        ),
      )}
    </template>
  )}

  <!-- 导航项模板（透传） -->
  <slot name="toolbar-nav" slot="toolbar-nav" />

  <!-- 弹窗（透传） -->
  <slot name="dialogs" />

  <!-- 页面注释（透传） -->
  <slot name="notes" slot="notes" />

  <!-- 文档交互脚本（代码复制） -->
  <script slot="scripts" is:inline type="module" src="/assets/app/page/doc.js"></script>

  <!-- 页面脚本（透传） -->
  <slot name="scripts" slot="scripts" />
</FrameworkLayout>
