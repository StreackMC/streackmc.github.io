---
/**
 * SelectorLayout — 分层选择器页面布局模板
 * 继承 FrameworkLayout（含工具栏 + 页脚），专用于逐层选择交互页面
 *
 * 类似 Apple 隐私页：正文流展示标题 → 描述 → 选择区，
 * 选项卡逐层下钻，单选项自动跳转，新选项卡滚动至视口，
 * 面包屑可回退，最终展示结果卡片。
 *
 * Props（除首栏图标外全部透传给 FrameworkLayout）:
 *   title       - 页面标题
 *   description - meta description
 *   keywords    - meta keywords
 *   theme       - s-page 主题（默认 light）
 *   config      - 选择器配置对象 { title, description, options: [...] }
 *   id          - 选择器实例 ID（用于 URL 同步 ?selector=id:path）
 *   history     - 是否添加历史记录条目（默认 true；false 则仅 replaceState 改地址栏）
 *   icon_svg    - 可选，首栏标题上方图标的**内联 SVG 源码**，会被包进 <s-icon>
 *   icon_src    - 可选，首栏标题上方图标的**图片地址**，会被包成 <img>
 *                 （icon_svg 与 icon_src 同时提供时以 icon_svg 为准；都不传则不渲染图标）
 *
 * Slots:
 *   toolbar-nav - 导航项模板（透传给 FrameworkLayout）
 *   notes       - 页面注释（透传给 FrameworkLayout）
 *   dialogs     - 页面弹窗（透传给 FrameworkLayout）
 *
 * 外部资源：
 *   CSS — /assets/code/selector.css
 *   JS  — /assets/code/selector.js（通过 [data-selector-config] JSON 读取配置）
 */
import FrameworkLayout from './FrameworkLayout.astro';
import PageIcon from '../components/PageIcon.astro';

interface SelectorConfig {
  title: string;
  description: string;
  options: any[];
}

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  theme?: string;
  config: SelectorConfig;
  id?: string;
  history?: boolean;
  icon_svg?: string;
  icon_src?: string;
}

const {
  title,
  description,
  keywords,
  theme = 'light',
  config,
  id,
  history = true,
  icon_svg,
  icon_src,
} = Astro.props;
---

<FrameworkLayout
  title={title}
  description={description}
  keywords={keywords}
  theme={theme}
>
  <!-- 导航项模板（透传） -->
  <slot name="toolbar-nav" slot="toolbar-nav" />

  <!-- 页面 CSS -->
  <link slot="head" rel="stylesheet" href="/assets/code/selector.css" />

  <!-- 正文内容（display:contents 包裹防止 Astro 解释 slot 属性） -->
  <div style="display: contents">
    <div class="content selector-content" slot="0">
      <div class="selector-wrap" data-selector {...(id ? { id } : {})} {...(history === false ? { 'data-selector-history': 'false' } : {})}>
        <!-- 首栏：图标（可选）+ 标题 + 描述
             布局取自 about/contact 的首栏（居中、图标独占标题上方一行），字号沿用下载页 -->
        <header class="selector-header">
          <h1 class="selector-title" style="--fs:24px;--fl:42px; --a:center; margin: 4rem auto 1.5rem;">
            <PageIcon icon_svg={icon_svg} icon_src={icon_src} />
            <span set:html={config.title} />
          </h1>
          {config.description && <p class="selector-description" set:html={config.description} />}
        </header>

        <!-- 面包屑（选择后出现） -->
        <nav class="selector-breadcrumb" data-breadcrumb></nav>

        <!-- 选择区：逐层渲染选项卡 -->
        <div class="selector-layers" data-layers></div>

        <!-- 最终结果 -->
        <div class="selector-result" data-result></div>

        <!-- 选择器配置（JSON 序列化，供 selector.js 读取） -->
        <script type="application/json" data-selector-config set:html={JSON.stringify(config)}></script>
      </div>
    </div>
  </div>

  <!-- 弹窗（透传） -->
  <slot name="dialogs" />

  <!-- 页面注释（透传） -->
  <slot name="notes" slot="notes" />

  <!-- 页面脚本 -->
  <script data-selector-page="independent" slot="scripts" is:inline type="module" src="/assets/code/selector.js"></script>
</FrameworkLayout>
