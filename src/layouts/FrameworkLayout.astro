---
/**
 * FrameworkLayout — Streack 框架页面布局
 * 用于首页等使用自定义框架的页面
 * 包含：工具栏（服务端渲染）、页脚（服务端渲染）、内容插槽系统
 *
 * Props:
 *   title       - 页面标题
 *   description - meta description
 *   keywords    - meta keywords
 *   theme       - s-page 主题（dark/light，默认 dark）
 *
 * Slots:
 *   default      - 页面内容（.content 插槽块）
 *   head         - 额外 <head> 资源（页面 CSS 等）
 *   toolbar-nav  - <template data-toolbar-nav> 导航项
 *   notes        - <template data-inject="notes"> 注释条目
 *   dialogs      - 页面弹窗（s-bottom-sheet, s-dialog 等）
 *   scripts      - 页面特定脚本
 */
import BaseLayout from './BaseLayout.astro';
import Toolbar from '../components/Toolbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  theme?: string;
}

const {
  title,
  description,
  keywords,
  theme = 'dark',
} = Astro.props;
---

<BaseLayout title={title} description={description} keywords={keywords}>
  <!-- 框架 CSS -->
  <link slot="head" rel="stylesheet" href="/assets/app/frame/framework.css" />
  <link slot="head" rel="stylesheet" href="/assets/app/component/popup.css" />
  <link slot="head" rel="stylesheet" href="/assets/app/component/search.css" />
  <!-- 页面特定 head 内容 -->
  <slot name="head" slot="head" />

  <s-page id="page" theme={theme}>
    <div class="unselectable" style="position: absolute;" id="no_script">
      <h1>您似乎没有启用JavaScript，而这是此网站正常运行所必须的。<br>此外，该页面不支持过老的浏览器内核。</h1>
    </div>

    <!-- 显示区域 -->
    <div id="main" class="main">
      <!-- 背景 -->
      <div class="bg"></div>
      <div class="bg-filter"></div>

      <!-- 工具栏（服务端渲染，原 framework.js fetch 注入） -->
      <Toolbar />

      <!-- 页面导航项模板 -->
      <slot name="toolbar-nav" />

      <!-- 正文 -->
      <div class="contents">
        <slot />

        <!-- 页脚（服务端渲染，原 framework.js fetch 注入） -->
        <Footer />

        <!-- 页面注释模板 -->
        <slot name="notes" />
      </div>
    </div>

    <!-- 页面弹窗 -->
    <slot name="dialogs" />
  </s-page>

  <script is:inline>
    window.streack = { meta: { initby: ["streack-web-framework/layout"] }, };
    window.streack.conf = typeof conf !== 'undefined' ? conf : null;
  </script>
  <script is:inline type="module" src="/assets/app/frame/entry.js"></script>

  <!-- 页面特定脚本 -->
  <slot name="scripts" />
</BaseLayout>
