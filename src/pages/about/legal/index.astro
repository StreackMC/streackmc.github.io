---
import SelectorLayout from '/src/layouts/SelectorLayout.astro';

// 首栏图标：内联 SVG 源码。交给 SelectorLayout 的 icon_svg 参数，
// 它会包进 Sober 的 <s-icon> 并渲染到标题上方一行（不再塞进 config.title）
const iconSvg = `<svg viewBox="0 -960 960 960"><path d="M200-280v-280h80v280h-80Zm240 0v-280h80v280h-80ZM80-120v-80h800v80H80Zm600-160v-280h80v280h-80ZM80-640v-80l400-200 400 200v80H80Zm178-80h444-444Zm0 0h444L480-830 258-720Z"></path></svg>`;

const config = {
  title: "法律信息",
  description: "查找我们的产品与服务的法律信息和资源。",
  layerTitle: "选择主题",
  options: [
    {
      label: "隐私政策",
      hint: "了解我们如何处理你的数据",
      layerTitle: "选择适用产品",
      children: [
        {
          label: "网站与游戏服务器",
          result: {
            title: `选择语言`,
            content: `
              <a href="/about/legal/privacy/game_zh-cn">简体中文</a><br>
            `
          }
        },
        {
          label: "“澪奈Neonai”互动服务",
          layerTitle: "选择适用平台",
          children: [
            {
              label: "QQ机器人",
              result: {
                title: `选择语言`,
                content: `
                  <a href="/about/legal/privacy/neonai_qq_zh-cn">简体中文</a>
                `
              }
            },
          ],
        },
      ]
    },
    {
      label: "用户协议",
      hint: "了解您在使用我们的产品时应知悉而遵守的内容",
      layerTitle: "选择适用产品",
      children: [
        {
          label: "所有",
          result: {
            title: `选择语言`,
            content: `
              <a href="/about/legal/tos/all_zh-cn">简体中文</a><br>
            `
          }
        },
      ]
    },
    {
      label: "版权许可",
      hint: "了解我们产出的内容如何与您共享",
      layerTitle: "选择适用产品",
      children: [
        {
          label: "所有",
          hint: "另行注明的除外",
          result: {
            title: `选择语言`,
            content: `
              <a href="/about/legal/tos/all_zh-cn">简体中文</a>
            `,
          }
        },
      ]
    },
  ]
};
---

<SelectorLayout
  title="法律信息 — 栈流Streack"
  description="栈流Streack隐私政策、服务条款与免责声明等法律信息的导览页"
  theme="light"
  config={config}
  id="legal"
  icon_svg={iconSvg}
>
  <template slot="toolbar-nav" data-toolbar-nav toolbar-set="about"></template>
</SelectorLayout>
