---
import FrameworkLayout from '../layouts/FrameworkLayout.astro';
---
<FrameworkLayout title="未知的页面 — 栈流Streack" description="404 Notfound Page" keywords="404,unknown,missingno"
  theme="light">

  <!-- 正文内容（display:contents 包裹防止 Astro 解释 slot 属性） -->
  <div style="display: contents">
    <!-- 内容块示例 1：全宽 Banner -->
    <div class="content" slot="0">
      <div class="slotBg-I" style="--u:white;"></div>
      <div style="--t: max(20vh, 12rem); --l:auto; --r: auto; --a: center;">
        <h1 style="--fs:35px;--fl:60px;">抱歉，但你要访问的网页找不到</h1>
        <!-- <p style="--fs:20px;--fl:36px;">描述文字</p> -->
        <s-button data-cmd="search:" style="margin-top: 2rem;" id="hostname-p">Search</s-button>
      </div>
    </div>
  </div>

  <script slot="scripts" is:inline type="module">
    document.getElementById('hostname-p').innerText = `搜索 ${location.hostname}`;
  </script>
</FrameworkLayout>