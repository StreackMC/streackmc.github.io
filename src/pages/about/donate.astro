---
import FrameworkLayout from '../../layouts/FrameworkLayout.astro';
---
<FrameworkLayout title="捐赠与赞助 — 栈流Streack" description="支持栈流Streack的公益运营，每一份赞助都让这片天地走得更远。" keywords="捐赠,赞助,公益,支付宝,微信,QQ"
  theme="light">

  <link slot="head" rel="stylesheet" href="/assets/app/page/donate.css" />
  <template slot="toolbar-nav" data-toolbar-nav toolbar-set="about"></template>

  <div style="display: contents">
    <!-- Hero：标题 + 一句价值主张 -->
    <div class="content" slot="0">
      <div
        style="position: relative; padding-top: var(--safezone, 0); --l:auto; --r:auto; --a: center; width: min(1024px, calc(var(--w) * 0.6));">
        <h1 style="--fs:36px;--fl:52px; --a:center; margin: 4rem auto 0rem auto;">
          <s-icon style="width: 1.5em; margin-bottom: .5em;">
            <svg viewBox="0 -960 960 960">
              <path
                d="M668.5-531.5Q680-543 680-560t-11.5-28.5Q657-600 640-600t-28.5 11.5Q600-577 600-560t11.5 28.5Q623-520 640-520t28.5-11.5ZM320-600h200v-80H320v80ZM180-120q-34-114-67-227.5T80-580q0-92 64-156t156-64h200q29-38 70.5-59t89.5-21q25 0 42.5 17.5T720-820q0 6-1.5 12t-3.5 11q-4 11-7.5 22.5T702-751l91 91h87v279l-113 37-67 224H480v-80h-80v80H180Zm60-80h80v-80h240v80h80l62-206 98-33v-141h-40L620-720q0-20 2.5-38.5T630-796q-29 8-51 27.5T547-720H300q-58 0-99 41t-41 99q0 98 27 191.5T240-200Zm240-298Z">
              </path>
            </svg>
          </s-icon><br>
          捐赠与赞助
        </h1>
        <p style="--fs:16px;--fl:24px; --lh:1.35em; max-width: 90%; margin: 1.5rem auto 0 auto; --fw: 400;">
          每一份支持，都让这片天地走得更远。<br>
          在继续之前，请阅读<a href="/doc/policy/donate/">赞助方针</a>：
        </p>
        <iframe id="term-detail" src="/doc/policy/donate/?minialize=1" frameborder="0"></iframe>
        <s-checkbox id="term-checkbox" disabled="true">请稍后</s-checkbox>
      </div>
    </div>

    <!-- 支付二维码：支付宝 · 微信 · QQ -->
    <div class="content" slot="1">
      <s-fold id="payment" folded="true"
        style="position: relative; padding-top: var(--safezone, 0); --l:auto; --r:auto; --a: center; width: min(1024px, calc(var(--w) * 0.6));">
        <h2 style="--fs:24px;--fl:38px; --a:center; margin: 3rem auto 1.5rem;">Payment</h2>
        <figure class="donate-qr">
          <img id="payment-img" src="" alt="捐赠二维码，图中从左到右依次为支付宝、微信、QQ" />
          <figcaption>
            <span>支付宝</span>
            <span>微信</span>
            <span>QQ</span>
          </figcaption>
        </figure>
        <p style="--fs:14px;--fl:16px; --lh:1.5em; color: var(--s-color-secondary, #6e6e73); margin: 1.5rem auto 0;">
          <span mobile-only>点击图片以放大。<br></span>
          当你想要核销捐赠权益，请携支付单号<a href="/about/contact/">联系我们</a>。
        </p>
      </s-fold>
    </div>
  </div>

  <!-- 页面脚本 -->
  <script slot="scripts" is:inline type="module" src="/assets/app/page/donate.js"></script>
</FrameworkLayout>
