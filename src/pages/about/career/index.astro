---
import FrameworkLayout from '/src/layouts/FrameworkLayout.astro';
---
<FrameworkLayout title="广纳贤士 — 栈流Streack" description="栈流Streack团队的招新介绍页"
  theme="light">

  <template slot="toolbar-nav" data-toolbar-nav toolbar-set="about"></template>

  <!-- 正文内容 -->
  <div style="display: contents">
    <div class="content" slot="0" style="height: max-content;">
      <div
        style="position: relative; padding-top: var(--safezone, 0); --l:auto; --r:auto; --a: center; width: min(1024px, calc(var(--w) * 0.6));">
        <h2 style="--fs:24px;--fl:42px; --a:center; margin: 2rem auto;">
          <s-icon style="width: 1.5em; margin-bottom: .5em;">
            <svg data-v-49a22239="" viewBox="0 -960 960 960">
              <path data-v-49a22239=""
                d="M324-111.5Q251-143 197-197t-85.5-127Q80-397 80-480t31.5-156Q143-709 197-763t127-85.5Q397-880 480-880h40v331q18 11 29 28.5t11 40.5q0 33-23.5 56.5T480-400q-33 0-56.5-23.5T400-480q0-23 11-41t29-28v-86q-52 14-86 56.5T320-480q0 66 47 113t113 47q66 0 113-47t47-113q0-36-14.5-66.5T586-600l57-57q35 33 56 78.5t21 98.5q0 100-70 170t-170 70q-100 0-170-70t-70-170q0-90 57-156.5T440-717v-81q-119 15-199.5 105T160-480q0 134 93 227t227 93q134 0 227-93t93-227q0-69-27-129t-74-104l57-57q57 55 90.5 129.5T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80q-83 0-156-31.5Z">
              </path>
            </svg>
          </s-icon><br>
          加入我们，展现自我。
        </h2>
        <p style="--fs:18px;--fl:32px; max-width: 90%; --lh: 1.3em">
          爱好者们齐聚此间，在再大的困困难难面前却从不放弃，因为凭借每个人的创造力，我们一定可以一路前行。
          于此间，加入我们不仅可以为我们带来精彩的新思维，更是为了共同的喜好而共舞。
        </p>
      </div>
    </div>
    <div class="content" slot="1" style="height: max-content;">
      <div id="jobcards" style="position: relative; padding-top: var(--safezone, 0); --l:auto; --r:auto; --a: start; width: min(1024px, calc(var(--w) * 0.6));">
      </div>
    </div>

  </div>

  <!-- 页面独有逻辑 -->
  <script slot="scripts" is:inline type="module">
    import { openURL } from '/assets/app/framework.js';
    const container = document.getElementById('jobcards');
    [
      {
        // 职位
        "what": "暂无",
        // 地点
        "where": "目前 Streack Team 暂时没有发布招聘需求",
        // 工作内容
        "todo": "点击以刷新",
        // 需求
        "wanna": "",
        // 福利待遇
        "reward": "",
        // 详细地址
        "detail": ".",
      },
      {
        "what": "",
        "where": "",
        "todo": "",
        "wanna": "",
        "reward": "",
        "detail": "",
      },
    ].forEach((job)=>{
      if (!job?.what) return;
      const card = document.createElement('s-card');
      card.type = 'outlined';
      card.classList.add('jobs_container');
      card.innerHTML = `
        <!-- <img slot="image" src="cover.jpg" alt=""> -->
        <div slot="headline">${job.what.replace(/\n/g, '<br>') }</div>
        <div slot="subhead">${job.where.replace(/\n/g, '<br>') }</div>
        <div slot="text">${job.todo.replace(/\n/g, '<br>') }<br>${job.wanna.replace(/\n/g, '<br>') }<br>${job.reward.replace(/\n/g,'<br>')}</div>
      `;
      card.clickable = true;
      card.addEventListener('click', () => openURL(job.detail, true));
      container.appendChild(card);
    });

    const style = document.createElement('style');
    style.innerText = `
      div#jobcards { flex-direction: row; flex-wrap: wrap; gap: 1rem; }
      body s-card.jobs_container { width: fit-content; padding: 1rem 1.5rem; height: max-content; min-width: calc(50% - 1rem); max-width: 100%; }
      body s-card.jobs_container div[slot="headline"] { font-size: 1.5rem; }
      body s-card.jobs_container div[slot="subhead"] { font-size: 1rem; }
      body s-card.jobs_container div[slot="text"] { font-size: .875rem; }
    `;
    document.body.appendChild(style);
  </script>
</FrameworkLayout>