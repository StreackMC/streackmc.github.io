---
import FrameworkLayout from '/src/layouts/FrameworkLayout.astro';
---
<FrameworkLayout title="Forwarding — 栈流Streack" theme="light"
  redirect="/about/legal/?selector=legal%3A版权许可">

  <div style="display: contents">
    <div class="content" slot="0">
      <div class="slotBg-I" style="--u:white;"></div>
      <div style="--t: calc(max(10vh, 5rem) + var(--safezone, 0)); --l:auto; --r: auto; --a: center;">
        <h1 style="--fs:35px;--fl:60px;max-width:calc(var(--w) * 0.8);">请稍后</h1>
      </div>
    </div>
  </div>

</FrameworkLayout>