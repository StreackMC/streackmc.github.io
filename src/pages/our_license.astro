---
import FrameworkLayout from '../layouts/FrameworkLayout.astro';
---
<FrameworkLayout title="Forwarding — 栈流Streack" description="404 Notfound Page" keywords="404,unknown,missingno"
  theme="light">

  <!-- 正文内容（display:contents 包裹防止 Astro 解释 slot 属性） -->
  <div style="display: contents">
    <!-- 内容块示例 1：全宽 Banner -->
    <div class="content" slot="0">
      <div class="slotBg-I" style="--u:white;"></div>
      <div style="--t: calc(max(10vh, 5rem) + var(--safezone, 0)); --l:auto; --r: auto; --a: center;">
        <h1 style="--fs:35px;--fl:60px;max-width:calc(var(--w) * 0.8);">请稍后</h1>
      </div>
    </div>
  </div>

  <script slot="scripts" is:inline type="module">
    location.replace('/about/legal?selector=legal%3A版权许可.所有');
  </script>
</FrameworkLayout>