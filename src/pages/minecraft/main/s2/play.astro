---
import SelectorLayout from '/src/layouts/SelectorLayout.astro';
const config = {
  title: "开始游戏",
  description: "按需选择你需要的内容，随后在S2「岭回双壑风」里尽情展现你的创意或是来一场轰轰烈烈的冒险。",
  layerTitle: "选择游戏平台",
  options: [
    {
      label: "Java版",
      hint: "",
      layerTitle: "选择网络线路",
      children: [
        {
          label: "Streack Edgenode",
          hint: "",
          layerTitle: "选择 SEN 节点",
          children: [
            {
              label: "杭州 BGP",
              hint: "",
              result: {
                content: `地址：<a class="selectable" clickable data-cmd="cp:play-sen1.streack.top">play-sen1.streack.top</a><br><small nosugar style="font-size: .9em;">“Streack Edgenode”是最近上新的自研新线路技术，在部分情形下可为你提供更好的网络质量。</small>`
              }
            },
          ]
        },
        {
          label: "浙江电信",
          hint: "部分时段可能质量较差",
          result: {
            content: `地址：<a class="selectable" clickable data-cmd="cp:play.streack.top">play.streack.top</a>`
          }
        },
        {
          label: "浙江电信（嘉欣）",
          hint: "",
          result: {
            content: `地址：<a class="selectable" clickable data-cmd="cp:play2.streack.top">play2.streack.top</a>`
          }
        },
      ]
    },
    {
      label: "基岩版",
      hint: "已为此版本优化",
      layerTitle: "选择网络线路",
      children: [
        {
          label: "浙江电信",
          hint: "部分时段可能质量较差",
          result: {
            content: `
              <p class="unselectable">
                地址：<a class="selectable" clickable data-cmd="cp:be.streack.top">be.streack.top</a><br>
                端口：<a class="selectable" clickable data-cmd="cp:25882">25882</a><br>
                <s-button data-cmd="url:minecraft://?addExternalServer=%E6%A0%88%E6%B5%81Streack|be.streack.top:25882|">打开Minecraft: Bedrock Edition</s-button><br>
                <small nosugar style="font-size: .9em;">需要你的设备上安装“Minecraft”；不支持“我的世界：移动版”。</small>
              </p>`
          }
        },
        {
          label: "山东移动",
          hint: "",
          result: {
            content: `
              <p class="unselectable">
                地址：<a class="selectable" clickable data-cmd="cp:be2.streack.top">be2.streack.top</a><br>
                端口：<a class="selectable" clickable data-cmd="cp:25882">25882</a><br>
                <s-button data-cmd="url:minecraft://?addExternalServer=%E6%A0%88%E6%B5%81Streack|be2.streack.top:25882|">打开Minecraft: Bedrock Edition</s-button><br>
                <small nosugar style="font-size: .9em;">需要你的设备上安装“Minecraft”；不支持“我的世界：移动版”。</small>
              </p>`
          }
        },
      ]
    },
  ]
};
---

<SelectorLayout
  title="开始游戏 - S2「岭回双壑风」 — 栈流Streack"
  description="加入第三方公益服务器栈流Streack S2「岭回双壑风」的指引页面"
  theme="light"
  config={config}
  id="play"
>
  <template slot="toolbar-nav" data-toolbar-nav toolbar-set="mc-main"></template>

</SelectorLayout>
