    <!-- 页面独有逻辑（循环卡片等可选组件由上方 features 声明按需加载） -->
    <script slot="scripts" is:inline type="module">
      import { requestInitFunc } from '/assets/app/frame/init-hooks.js';

      requestInitFunc(() => {
        // 需要「框架就绪」后才执行的页面逻辑
        requestAnimationFrame(() => { document.querySelectorAll('video.slotBg-V').forEach(e => e.play()); });
      });

      // register replay logic
      (function () {
        const btns = document.querySelectorAll('.video-replay-btn');
        btns.forEach((btn) => {
          const bind = btn.dataset.replay;
          if (!bind) {
            console.error('[streack/page.replay_btn.bind] failed to find target video of ', btn, ', because no available data-replay provided.');
            return;
          }
          const videos = document.querySelectorAll(`video[data-replay="${bind}"]`);
          if (videos.length != 1) {
            console.error('[streack/page.replay_btn.bind] failed to bind target video of ', btn, ', because no available and unique HTMLVideoElement finded.');
            return;
          }
          const video = videos[0];

          function onVideoStop(event) {
            btn.disabled = false;
          }
          function onBtnClick(event) {
            btn.disabled = true;
            video.currentTime = 0;
            video.play();
          }

          video.addEventListener('ended', onVideoStop);
          video.addEventListener('pause', onVideoStop);
          btn.addEventListener('click', onBtnClick);
          btn.disabled = true;
        });
      })();

    </script>
