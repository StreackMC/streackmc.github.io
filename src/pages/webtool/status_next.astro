---
/**
 * 在线状态查询 — 升级维护中页面
 */
import ToolLayout from '../../layouts/ToolLayout.astro';
---

<ToolLayout title="在线状态查询">
  <link slot="head" rel="stylesheet" href="https://rs.kdxiaoyi.top/res/static/site_rs/not_found_page.css" />

  <s-card id="notice" class="main-card">
    <p>
    <h1 style="font-weight: lighter;">抱歉。<br>此页面正在升级维护中，暂时无法提供服务。</h1>
    </p>
    <s-button onclick="window.history.back();">
      <s-icon slot="start" name="arrow_back"></s-icon>
      返回上一页
    </s-button>
    <s-button type="elevated" onclick="openURL('/',true);">
      <s-icon slot="start" name="home"></s-icon>
      回到主页
    </s-button>
    <s-button type="elevated" onclick="openURL('./status',true);">
      <s-icon slot="start" name="arrow_forward"></s-icon>
      使用旧版查询页
    </s-button>
    <s-button type="text" onclick="openHELP();">
      <s-icon slot="start"><svg viewBox="0 -960 960 960">
        <path d="M478-240q21 0 35.5-14.5T528-290q0-21-14.5-35.5T478-340q-21 0-35.5 14.5T428-290q0 21 14.5 35.5T478-240Zm-36-154h74q0-33 7.5-52t42.5-52q26-26 41-49.5t15-56.5q0-56-41-86t-97-30q-57 0-92.5 30T342-618l66 26q5-18 22.5-39t53.5-21q32 0 48 17.5t16 38.5q0 20-12 37.5T506-526q-44 39-54 59t-10 73Zm38 314q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z"></path>
      </svg></s-icon>
      发生了什么
    </s-button>
  </s-card>

  <Fragment slot="dialogs">
    <s-dialog id="help">
    <div slot="headline"> 升级维护 </div>
    <div slot="text">
      <p class="unselectable">
        我们将对本页面进行一次升级，扩充其原有功能。<br>
        在此期间相关页面将无法访问，还请谅解。
      </p>
    </div>
    <s-button
      onclick="openURL('https://streack.top/doc/updata/s1p2/#26w19a:~:text=%E6%9A%82%E6%97%B6%E5%81%9C%E7%94%A8%20HTTPServer%20%E4%BB%A5%E5%8F%8A%E5%85%A8%E9%83%A8%E7%9B%B8%E5%85%B3%E6%9C%8D%E5%8A%A1',false);"
      slot="action" type="text">
      查看相关的更新日志
      <s-icon slot="end"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960">
        <path d="M200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h280v80H200v560h560v-280h80v280q0 33-23.5 56.5T760-120H200Zm188-212-56-56 372-372H560v-80h280v280h-80v-144L388-332Z"></path>
      </svg></s-icon>
    </s-button>
    <s-button slot="action" type="text">确定</s-button>
    </s-dialog>
  </Fragment>

  <script slot="scripts" is:inline src="https://rs.kdxiaoyi.top/res/static/site_rs/not_found_page.js"></script>
</ToolLayout>
