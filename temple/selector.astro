---
/**
 * Selector 模版 — 分层选择器
 *
 * ═══════════════════════════════════════════════════════════════
 *  两种使用方式
 * ═══════════════════════════════════════════════════════════════
 *
 *  ① 整页模式（SelectorLayout）— 独占一个页面
 *  ─────────────────────────────────────────────────────────────
 *    import SelectorLayout from '/src/layouts/SelectorLayout.astro';
 *
 *    <SelectorLayout
 *      title="页面标题"
 *      description="页面描述"
 *      theme="light"
 *      config={config}
 *      id="legal"           // 可选，用于 URL 同步
 *    />
 *
 *  ② 嵌入模式（Selector 组件）— 作为控件插入任意页面
 *  ─────────────────────────────────────────────────────────────
 *    import Selector from '/src/components/Selector.astro';
 *
 *    <Selector config={config} id="faq" />
 *
 *  ═══════════════════════════════════════════════════════════════
 *  URL 同步（需要设置 id 属性）
 *  ═══════════════════════════════════════════════════════════════
 *
 *  页面加载时读取 ?selector= 参数，格式：
 *    id:label.sublabel|id2:label2.sublabel2
 *
 *  示例：?selector=legal:隐私政策.我们收集的信息.账户信息
 *  多控件：?selector=legal:隐私政策|faq:退款.方式
 *
 *  - 按 . 分隔的路径逐层选中对应 label 的按钮
 *  - 用户交互后自动 pushState 更新参数
 *  - 浏览器前进/后退时 popstate 重新应用
 *
 *  ═══════════════════════════════════════════════════════════════
 *  配置结构
 *  ═══════════════════════════════════════════════════════════════
 *
 *  config = {
 *    title: "选择主题",           // 根层回退标题（整页模式也渲染为 <h1>）
 *    description: "描述文本",     // 仅整页模式渲染
 *    layerTitle: "请选择…",       // 可选，根层选择区域标题
 *    options: [
 *      {
 *        label: "选项A",
 *        hint: "可选副标题",
 *        layerTitle: "请选择…",   // 可选，该选项子层标题（默认用 label）
 *        children: [...],         // 有子选项 → 继续下钻
 *        // result: { title, content, html }  // 或最终结果（两者互斥）
 *      }
 *    ]
 *  }
 */

const config = {
  title: "选择主题",
  description: "选择一个主题以查看相关内容。点击选项卡逐层深入，直至找到你需要的详细信息。",
  layerTitle: "请选择法律主题",
  options: [
    {
      label: "隐私政策",
      children: [
        {
          label: "信息的使用",
          layerTitle: "选择具体条款",
          children: [
            {
              label: " Cookies 与同类技术",
              result: {
                title: "Cookies 与同类技术",
                content: "<p>我们使用 Cookies 来存储你的偏好设置和登录状态。</p><ul><li>会话 Cookies：关闭浏览器后自动删除</li><li>持久 Cookies：在设定期限后过期</li></ul>"
              }
            },
            {
              label: "日志信息",
              result: {
                title: "日志信息",
                content: "<p>当你访问我们的服务器时，我们会自动记录部分日志信息，包括 IP 地址、访问时间、浏览器类型等。</p>"
              }
            }
          ]
        },
        {
          label: "信息披露",
          result: {
            title: "信息披露",
            content: "<p>我们不会向第三方出售或出租你的个人信息。在以下情况下可能共享：</p><ul><li>获得你的明确同意</li><li>法律法规要求</li><li>保护我方合法权益</li></ul>"
          }
        }
      ]
    },
    {
      label: "服务条款",
      result: {
        title: "服务条款",
        content: "<p>使用 Streack 的服务即表示你同意以下条款：</p><ul><li>遵守社区准则</li><li>不进行恶意行为</li><li>尊重知识产权</li></ul>"
      }
    },
    {
      label: "免责声明",
      result: {
        title: "免责声明",
        content: "<p>Streack 提供的内容按\"现状\"提供，不保证其准确性或完整性。</p><p>对于因使用本服务而产生的任何直接或间接损失，我们不承担责任。</p>"
      }
    }
  ]
};
---

/*
 * 整页模式示例（取消注释以使用）：
 *
 * import SelectorLayout from '/src/layouts/SelectorLayout.astro';
 *
 * <SelectorLayout
 *   title="法律与隐私 — 栈流Streack"
 *   description="选择法律主题以查看相关条款"
 *   theme="light"
 *   config={config}
 *   id="legal"
 * />
 */

/*
 * 嵌入模式示例（取消注释以使用）：
 *
 * import Selector from '/src/components/Selector.astro';
 *
 * <Selector config={config} id="legal" />
 */
