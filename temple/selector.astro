/**
 * Selector 模版 — 分层选择器
 *
 * ═══════════════════════════════════════════════════════════════
 *  两种使用方式
 * ═══════════════════════════════════════════════════════════════
 *
 *  ① 整页模式（SelectorLayout）— 独占一个页面
 *  ─────────────────────────────────────────────────────────────
 *    import SelectorLayout from '/src/layouts/SelectorLayout.astro';
 *
 *    <SelectorLayout
 *      title="页面标题"
 *      description="页面描述"
 *      theme="light"
 *      config={config}
 *      id="legal"                    // 可选：参与 URL 同步；不写则完全不使用该功能
 *      history={false}               // 可选：仅在设了 id 时有意义；false = 只改地址栏、不加历史条目
 *      icon_svg="<svg …>…</svg>"     // 可选：标题上方图标（内联 SVG，包进 <s-icon>）
 *      icon_src="/assets/img/x.svg"  // 可选：标题上方图标（图片，包成 <img>）
 *    />
 *
 *  ② 嵌入模式（Selector 组件）— 作为控件插入任意页面
 *  ─────────────────────────────────────────────────────────────
 *    import Selector from '/src/components/Selector.astro';
 *
 *    <Selector config={config} />                            // 不参与 URL 同步
 *    <Selector config={config} id="faq" />                   // 参与 URL 同步
 *    <Selector config={config} id="faq" history={false} />   // 同步参数、但不加历史条目
 *
 *  嵌入模式不渲染标题/描述（上下文由宿主页面提供），因此**没有图标参数** ——
 *  图标只属于整页模式的首栏。
 *
 *  ═══════════════════════════════════════════════════════════════
 *  可选图标（仅整页模式；渲染在标题上方一行）
 *  ═══════════════════════════════════════════════════════════════
 *
 *    <!-- 内联 SVG（推荐：无额外请求，颜色随主题） -->
 *    icon_svg="<svg viewBox='0 -960 960 960'><path d='M200-280v-280h80v280h-80Z'/></svg>"
 *
 *    <!-- 或图片地址 -->
 *    icon_src="/assets/img/legal.svg"
 *
 *  · 两者都提供时以 icon_svg 为准；都不提供（或传空串）则不渲染图标，也不多余换行
 *  · 由 src/components/PageIcon.astro 统一处理，图标自带 <br> 故独占标题上方一行
 *  · 尺寸 1.5em，随标题字号缩放
 *  · 图标请走这个参数，**不要写进 config.title**：虽然标题用 set:html 渲染、
 *    写 HTML 也能显示，但那样用不了 icon_src，描述里也会带上标签
 *
 *  ═══════════════════════════════════════════════════════════════
 *  URL 同步 / 历史记录：两级开关
 *  ═══════════════════════════════════════════════════════════════
 *
 *  ① 不设 id —— **完全不使用该功能**
 *     不读 ?selector、不写 URL、不产生任何历史条目（连 replaceState 都不调）。
 *     纯展示、或不需要分享 / 回退状态的选择器，不写 id 即可。
 *     多实例页面里，未设 id 的实例不影响其它实例的参数。
 *
 *  ② 设了 id —— 参与同步
 *     ?selector=id:label.sublabel|id2:label2.sublabel2
 *       单控件：?selector=legal:隐私政策.我们收集的信息.账户信息
 *       多控件：?selector=legal:隐私政策|faq:退款.方式
 *     · 页面加载时按 . 分隔的路径逐层选中对应 label 的按钮
 *     · 用户交互后更新参数；浏览器前进/后退（popstate）重新应用
 *     · 默认 pushState —— 新增历史条目，可按后退键逐步回退选择过程
 *     · history={false} → 一律 replaceState：只改地址栏、不增加历史条目
 *       （「重新选择」与面包屑回退同样如此，不会把历史记录撑大）
 *
 *     怎么选：要能按后退回退选择过程 → 设 id（默认）
 *             只想让地址栏体现/可分享当前选择，但不污染历史 → id + history={false}
 *             完全不需要 → 不设 id
 *
 *  ═══════════════════════════════════════════════════════════════
 *  配置结构
 *  ═══════════════════════════════════════════════════════════════
 *
 *  config = {
 *    title: "选择主题",           // 根层回退标题（整页模式也渲染为 <h1>）
 *    description: "描述文本",     // 仅整页模式渲染
 *    layerTitle: "请选择…",       // 可选，根层选择区域标题
 *    options: [
 *      {
 *        label: "选项A",
 *        hint: "可选副标题",
 *        layerTitle: "请选择…",   // 可选，该选项子层标题（默认用 label）
 *        children: [...],         // 有子选项 → 继续下钻
 *        // result: { title, content, html }  // 或最终结果（两者互斥）
 *      }
 *    ]
 *  }
 */

const config = {
  title: "选择主题",
  description: "选择一个主题以查看相关内容。点击选项卡逐层深入，直至找到你需要的详细信息。",
  layerTitle: "请选择法律主题",
  options: [
    {
      label: "隐私政策",
      children: [
        {
          label: "信息的使用",
          layerTitle: "选择具体条款",
          children: [
            {
              label: " Cookies 与同类技术",
              result: {
                title: "Cookies 与同类技术",
                content: "<p>我们使用 Cookies 来存储你的偏好设置和登录状态。</p><ul><li>会话 Cookies：关闭浏览器后自动删除</li><li>持久 Cookies：在设定期限后过期</li></ul>"
              }
            },
            {
              label: "日志信息",
              result: {
                title: "日志信息",
                content: "<p>当你访问我们的服务器时，我们会自动记录部分日志信息，包括 IP 地址、访问时间、浏览器类型等。</p>"
              }
            }
          ]
        },
        {
          label: "信息披露",
          result: {
            title: "信息披露",
            content: "<p>我们不会向第三方出售或出租你的个人信息。在以下情况下可能共享：</p><ul><li>获得你的明确同意</li><li>法律法规要求</li><li>保护我方合法权益</li></ul>"
          }
        }
      ]
    },
    {
      label: "服务条款",
      result: {
        title: "服务条款",
        content: "<p>使用 Streack 的服务即表示你同意以下条款：</p><ul><li>遵守社区准则</li><li>不进行恶意行为</li><li>尊重知识产权</li></ul>"
      }
    },
    {
      label: "免责声明",
      result: {
        title: "免责声明",
        content: "<p>Streack 提供的内容按\"现状\"提供，不保证其准确性或完整性。</p><p>对于因使用本服务而产生的任何直接或间接损失，我们不承担责任。</p>"
      }
    }
  ]
};
