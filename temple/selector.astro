 * 注：此处必须整体写成 JSX 注释的形式 —— Astro 模板体里的普通块注释
 *     并不能阻止其中的 <组件 /> 被编译，未导入时会报 "xxx is not defined"。
 *
 * import SelectorLayout from '/src/layouts/SelectorLayout.astro';
 *
 * <!-- ① 默认：设 id，可用后退键回退选择过程 -->
 * <SelectorLayout
 *   title="法律与隐私 — 栈流Streack"
 *   description="选择法律主题以查看相关条款"
 *   theme="light"
 *   config={config}
 *   id="legal"
 * />
 *
 * <!-- ② 带图标 + 不污染历史记录：设 id 但 history={false} -->
 * <SelectorLayout
 *   title="法律与隐私 — 栈流Streack"
 *   theme="light"
 *   config={config}
 *   id="legal"
 *   history={false}
 *   icon_svg="<svg viewBox='0 -960 960 960'><path d='M200-280v-280h80v280h-80Z'/></svg>"
 * />
 *
 * <!-- ③ 完全不用 URL 功能：不写 id（连地址栏都不会被改） -->
 * <SelectorLayout
 *   title="法律与隐私 — 栈流Streack"
 *   theme="light"
 *   config={config}
 * />
 *
 * <!-- 图标也可以换成图片 -->
 * <SelectorLayout config={config} icon_src="/assets/img/legal.svg" />
 */}

