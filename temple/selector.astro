---
/**
 * Selector 分层选择器模版 (Astro 版)
 *
 * 以 SelectorLayout (Astro) 为主框架，Sober UI 组件 (s-card / s-button) 为辅。
 * CSS/JS 已拆分为外部文件，页面仅保留数据配置。
 *
 * 使用方式：
 *   1. 复制本文件到 src/pages/your-page.astro
 *   2. 修改下方 config 对象
 *   3. 调整 SelectorLayout 的 title / theme 等属性
 *
 * 文件结构：
 *   src/layouts/SelectorLayout.astro  — 布局（HTML 骨架 + 引用外部 CSS/JS）
 *   public/assets/code/selector.css   — 样式
 *   public/assets/code/selector.js    — 交互逻辑（从 #selector-config JSON 读取配置）
 *   src/pages/your-page.astro         — 仅数据配置
 *
 * 配置结构：
 *   每个选项 = { label, hint?, children? | result? }
 *   children → 有子选项，继续下钻
 *   result: { title, content(HTML) } → 最终结果
 *   两者互斥
 */
import SelectorLayout from '/src/layouts/SelectorLayout.astro';

const config = {
  title: "选择主题",
  description: "选择一个主题以查看相关内容。点击选项卡逐层深入，直至找到你需要的详细信息。",
  layerTitle: "请选择主题",
  options: [
    {
      label: "隐私政策",
      hint: "了解我们如何处理你的数据",
      children: [
        {
          label: "我们收集的信息",
          hint: "数据收集类型与范围",
          children: [
            {
              label: "账户信息",
              result: {
                title: "账户信息",
                content: `<p>当你注册栈流Streack账户时，我们会收集以下信息：</p>
                <ul>
                  <li>用户名与邮箱地址</li>
                  <li>加密后的密码（仅存储哈希值）</li>
                  <li>注册时间与IP地址（用于安全审计）</li>
                </ul>
                <p>这些信息仅用于账户管理与身份验证，不会向第三方分享。</p>`
              }
            },
            {
              label: "游戏数据",
              result: {
                title: "游戏数据",
                content: `<p>在游戏过程中，服务器会记录以下数据：</p>
                <ul>
                  <li>玩家位置、背包与游戏进度</li>
                  <li>聊天消息（用于违规行为审查）</li>
                  <li>登录/登出时间与在线时长</li>
                </ul>
                <p>这些数据存储在服务器数据库中，用于提供游戏服务与维护社区秩序。</p>`
              }
            }
          ]
        },
        {
          label: "信息的使用",
          // 仅一个子项 → 自动选中并继续
          children: [
            {
              label: "使用方式",
              result: {
                title: "信息的使用方式",
                content: `<p>我们收集的信息仅用于以下目的：</p>
                <ol>
                  <li><b>提供服务</b> — 运行游戏服务器、维护玩家数据</li>
                  <li><b>安全保障</b> — 防止恶意行为、处理违规举报</li>
                  <li><b>服务改进</b> — 分析使用趋势以优化体验</li>
                </ol>
                <p>我们绝不会将你的个人信息出售或用于商业广告目的。</p>`
              }
            }
          ]
        }
      ]
    },
    {
      label: "服务条款",
      hint: "使用我们的服务即表示你同意这些条款",
      result: {
        title: "服务条款",
        content: `<p>欢迎使用栈流Streack。使用我们的服务器与服务即表示你接受以下条款：</p>
        <ul>
          <li>你必须遵守所有适用的法律法规</li>
          <li>不得使用作弊客户端、外挂或利用游戏漏洞</li>
          <li>尊重其他玩家，禁止骚扰、歧视或恶意行为</li>
          <li>管理员保留对违规行为进行处罚的权利</li>
        </ul>
        <p>如对条款有疑问，请通过<a href="/about/contact">联系我们</a>页面获取帮助。</p>`
      }
    },
    {
      label: "免责声明",
      hint: "服务可用性与责任限制",
      result: {
        title: "免责声明",
        content: `<p>栈流Streack提供的服务按"现状"提供，不附带任何明示或暗示的保证。</p>
        <ul>
          <li>服务器可能因维护、故障或其他原因随时中断服务</li>
          <li>因不可抗力导致的服务中断，我们不承担责任</li>
          <li>玩家应自行备份重要游戏数据</li>
          <li>对于因使用本服务而产生的任何间接损失，我们不承担责任</li>
        </ul>`
      }
    }
  ]
};
---

<SelectorLayout
  title="Selector 模版 — 栈流Streack"
  description="分层选择器模版，类似 Apple 隐私页的逐层选择交互"
  theme="light"
  config={config}
>
  <!-- 导航项 -->
  <template slot="toolbar-nav" data-toolbar-nav></template>
</SelectorLayout>
