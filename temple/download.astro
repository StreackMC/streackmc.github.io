---
/**
 * Temple — 下载页完整模板
 * 基于 DownloadLayout，包含所有区域的示例数据
 *
 * 使用方式：复制此文件到目标目录，替换占位内容即可
 *
 * 布局：
 *   [图标 + 标题]        ← heading / icon_svg / icon_src
 *   [版本日志 / 说明]   ← default slot
 *   [下载按钮]           ← buttons slot
 *   [淡化附加信息]       ← additional-info slot
 *
 * 所需替换：
 *   - title / description / keywords → 页面 meta
 *   - heading → 下载页标题（渲染为 <h1>，居中）
 *   - 图标（可选，渲染在标题上方一行，由 src/components/PageIcon.astro 处理）：
 *       icon_svg="<svg viewBox='0 -960 960 960'><path d='…'/></svg>"  // 内联 SVG，包进 <s-icon>
 *       icon_src="/assets/img/x.svg"                                   // 图片地址，包成 <img>
 *     两者都给时以 icon_svg 为准；都不给（或留空串）则不渲染图标，也不多余换行。
 *     图标请走这个参数，不要写进 heading —— heading 是纯文本，会被转义。
 *   - 导航栏 template → 返回链接
 *   - <time> → 发行日期
 *   - <p> → 版本说明
 *   - s-button data-cmd → 下载链接
 *   - SHA256 字符串
 *   - 空间需求 / 版本要求 / 外部跳转提示
 */
import DownloadLayout from '/src/layouts/DownloadLayout.astro';
---

<!-- 可选图标（渲染在标题上方一行）。二选一，也可都留空：
     icon_svg="<svg viewBox='0 -960 960 960'><path d='M200-280v-280h80v280h-80Z'/></svg>"
     icon_src="/assets/img/download.svg"
     两者都给时以 icon_svg 为准；都不给则不渲染图标。 -->
<DownloadLayout
  title="下载「存档名称」 — 栈流Streack"
  description="存档下载页面的描述"
  keywords="关键词,英文逗号,分隔"
  theme="light"
  heading="下载「存档名称」"
  icon_svg=""
  icon_src=""
>
  <!-- 导航项：返回上级页面 -->
  <template slot="toolbar-nav" data-toolbar-nav>
    <div pc-only data-cmd="url:/返回路径|" clickable>返回主页</div>
  </template>

  <!-- 区域 1：版本日志 / 说明（标题由 heading 渲染，这里只写日期与说明） -->
  <time datetime="YYYY-MM-DD" style="opacity:.6; font-size:.85rem;">YYYY-MM-DD</time>
  <p>在这里撰写版本说明。包含运营时间、版本周期、更新内容、停止支持说明等。</p>

  <!-- 区域 2：下载按钮 -->
  <s-button slot="buttons" data-cmd="url:https://example.com/download">下载存档</s-button>

  <!-- 区域 3：淡化附加信息 -->
  <div slot="additional-info">
    <p>将前往外部页面进行下载。你将需要：</p>
    <ul>
      <li>至少 <strong>X.XGB</strong> 的可用磁盘空间</li>
    </ul>
    <p style="margin-top: 1rem;">
      SHA256：<br/>
      <span class="sha256 selectable" data-sha256="f48ddecc522aed87fd64d21df651460f14813bdd247bb982597bd3d9a6d219e5"></span>
      <br>&nbsp;
    </p>
  </div>

  <!-- 注释模板 -->
  <template slot="notes" data-inject="notes">
  </template>

  <!-- 页面脚本 -->
  <script slot="scripts" is:inline type="module" src="/assets/app/page/download.js"></script>
</DownloadLayout>
