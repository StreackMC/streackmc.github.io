---
/**
 * Temple — 下载页完整模板
 * 基于 DownloadLayout，包含所有区域的示例数据
 *
 * 使用方式：复制此文件到目标目录，替换占位内容即可
 *
 * 布局：
 *   [版本日志 / 说明]   ← default slot
 *   [下载按钮]           ← buttons slot
 *   [淡化附加信息]       ← additional-info slot
 *
 * 所需替换：
 *   - title / description / keywords → 页面 meta
 *   - 导航栏 template → 返回链接
 *   - <h2> → 下载页标题
 *   - <time> → 发行日期
 *   - <p> → 版本说明
 *   - s-button data-cmd → 下载链接
 *   - SHA256 字符串
 *   - 空间需求 / 版本要求 / 外部跳转提示
 */
import DownloadLayout from '/src/layouts/DownloadLayout.astro';
---

<DownloadLayout
  title="下载「存档名称」 — 栈流Streack"
  description="存档下载页面的描述"
  keywords="关键词,英文逗号,分隔"
  theme="light"
>
  <!-- 导航项：返回上级页面 -->
  <template slot="toolbar-nav" data-toolbar-nav>
    <div pc-only data-cmd="url:/返回路径|true" clickable>返回主页</div>
  </template>

  <!-- 区域 1：版本日志 / 说明 -->
  <h2 style="--fs:24px;--fl:42px; --a:center; margin: 4rem auto 1.5rem;">下载「存档名称」</h2>

  <time datetime="YYYY-MM-DD" style="opacity:.6; font-size:.85rem;">YYYY-MM-DD</time>
  <p>在这里撰写版本说明。包含运营时间、版本周期、更新内容、停止支持说明等。</p>

  <!-- 区域 2：下载按钮 -->
  <s-button slot="buttons" data-cmd="url:https://example.com/download">下载存档</s-button>

  <!-- 区域 3：淡化附加信息 -->
  <div slot="additional-info">
    <p>点击下载按钮将跳转到外部网盘。下载前请注意：</p>
    <ul>
      <li>至少 <strong>X.XGB</strong> 的可用磁盘空间</li>
      <li>Minecraft Java Edition <strong>X.X.X</strong> 及更高版本</li>
    </ul>
    <p style="margin-top: 1rem;">
      SHA256：<br/>
      <span class="sha256 selectable" data-sha256="f48ddecc522aed87fd64d21df651460f14813bdd247bb982597bd3d9a6d219e5"></span>
    </p>
  </div>

  <!-- 注释模板 -->
  <template slot="notes" data-inject="notes">
  </template>

  <!-- 页面脚本 -->
  <script slot="scripts" is:inline type="module" src="/assets/code/download.js"></script>
</DownloadLayout>
