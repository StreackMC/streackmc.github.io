---
/**
 * Temple — 下载页纯净骨架模板
 * 最简结构，无示例数据，适合从零开始搭建下载页
 *
 * 使用方式：复制此文件到目标目录，按注释填充内容
 *
 * 与 download.astro 的区别：
 *   - 不含示例文字，所有区域均为空插槽
 *   - 不预设 SHA256 格式、不预设需求列表
 *   - 适合完全自定义的下载页
 */
import DownloadLayout from '/src/layouts/DownloadLayout.astro';
---

<!-- 可选图标（渲染在标题上方一行）。二选一，也可都留空：
     icon_svg="<svg viewBox='0 -960 960 960'><path d='M200-280v-280h80v280h-80Z'/></svg>"
     icon_src="/assets/img/download.svg"
     两者都给时以 icon_svg 为准；都不给则不渲染图标。 -->
<DownloadLayout
  title="下载「  」 — 栈流Streack"
  description=""
  keywords=""
  theme="light"
  heading="下载「  」"
  icon_svg=""
  icon_src=""
>
  <!-- 导航项 -->
  <template slot="toolbar-nav" data-toolbar-nav>
    <div pc-only data-cmd="purl:/你的路径" clickable>导航项</div>
  </template>

  <!-- ========== 区域 1：版本日志 / 说明 ========== -->
  <!-- ※ 标题改上面 heading 参数；这里只写 time 日期、p 说明内容。
       icon_svg（内联 SVG 源码，包进 <s-icon>）/ icon_src（图片地址，包成 <img>）
       用于在标题上方放图标，可选；两者都给时以 icon_svg 为准 ※ -->
  <time datetime="" style="opacity:.6; font-size:.85rem;"></time>
  <p></p>

  <!-- ========== 区域 2：下载按钮 ========== -->
  <!-- ※ 修改 data-cmd 为实际下载链接 ※ -->
  <s-button slot="buttons" data-cmd="url:你的下载链接">下载</s-button>

  <!-- ========== 区域 3：淡化附加信息 ========== -->
  <div slot="additional-info">
    <!-- ※ 添加外部链接提示、需求、SHA256 等 ※ -->
    <p>将前往外部页面进行下载。你将需要：</p>
    <ul>
      <li>至少 <strong>X.XGB</strong> 的可用磁盘空间</li>
    </ul>
    <p style="margin-top: 1rem;">
      SHA256：<br/>
      <span class="sha256 selectable" data-sha256="你的SHA256值"></span>
      <br>&nbsp;
    </p>
  </div>

  <!-- 注释模板（可选） -->
  <template slot="notes" data-inject="notes">
  </template>

  <!-- 页面脚本 -->
  <script slot="scripts" is:inline type="module" src="/assets/app/page/download.js"></script>
</DownloadLayout>
